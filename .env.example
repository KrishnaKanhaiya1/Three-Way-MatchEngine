# ============================================
# Three-Way Match Engine - Environment Config
# ============================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB Connection
# For local testing, use: mongodb://localhost:27017/3way
# For remote, use: mongodb+srv://your_username:your_password@cluster.mongodb.net/3way
MONGODB_URI=mongodb://localhost:27017/3way

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
# Keep this secret - never commit the real key!
GEMINI_API_KEY=your_gemini_api_key_here